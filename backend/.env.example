# ---- LLM -------------------------------------------------------------
# groq (free tier) or claude (paid)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
# Check console.groq.com/docs/models for the current model list
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss models only; higher = slower but more careful)
GROQ_REASONING_EFFORT=low

# Only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- Vector store ------------------------------------------------------
# atlas (MongoDB Atlas Vector Search) or memory (no DB, data lost on restart)
VECTOR_STORE=atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=study_notes
VECTOR_INDEX_NAME=vector_index

# ---- Embeddings (must match numDimensions in the Atlas index) ------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# ---- Tuning ------------------------------------------------------------
CHUNK_WORDS=350
CHUNK_OVERLAP=60
TOP_K=5
